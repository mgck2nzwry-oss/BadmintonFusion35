* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.xlsx binary
*.png binary
*.pdf binary

# Preserve the exact generated bytes covered by the published A10-R10 SHA-256 manifest.
examples/a10_r10/**/*.csv binary
examples/a10_r10/**/*.json binary
examples/a10_r10/**/*.toml binary
examples/a10_r10/**/*.trc binary
examples/a10_r10/*.svg binary
examples/a10_r10/checksums.sha256 binary
